[Unit]
Description=Check broker accounts for ASTRA model availability
Documentation=file:///mnt/pitchai-dev-data/services/auth-broker-astra-model-watch/current/docs/astra-model-watch.md
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/srv/auth-token-server/data/accounts
ConditionPathIsDirectory=/mnt/pitchai-dev-data/services/auth-broker-astra-model-watch/current/astra_model_watch
ConditionPathExists=/root/code/telegram_agent_server/main.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/mnt/pitchai-dev-data/services/auth-broker-astra-model-watch/current
ExecStart=/mnt/pitchai-dev-data/services/auth-broker-astra-model-watch/current/ops/run_astra_model_watch.sh --once
TimeoutStartSec=2min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/pitchai-dev-data/monitoring/auth-broker-astra-model-watch
ReadWritePaths=/mnt/pitchai-dev-data/scratch/auth-broker-astra-model-watch
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=append:/mnt/pitchai-dev-data/monitoring/auth-broker-astra-model-watch/durable-console.log
StandardError=append:/mnt/pitchai-dev-data/monitoring/auth-broker-astra-model-watch/durable-console.log
