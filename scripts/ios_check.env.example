# Copy this file to scripts/ios_check.env and set the project values.
#
# For app/workspace repositories, set either IOS_CHECK_WORKSPACE or
# IOS_CHECK_PROJECT plus IOS_CHECK_SCHEME. Xcode gates are enabled
# automatically when a scheme and project/workspace are configured.

IOS_CHECK_WORKSPACE="App.xcworkspace"
# IOS_CHECK_PROJECT="App.xcodeproj"
IOS_CHECK_SCHEME="App"
IOS_CHECK_CONFIGURATION="Debug"
IOS_CHECK_DESTINATION="platform=iOS Simulator,name=iPhone 16,OS=latest"
IOS_CHECK_DERIVED_DATA=".build/DerivedData/check"
# Optional: use Xcode's noninteractive netrc provider for public/package CI
# resolution when the macOS keychain is unavailable. Leave empty by default.
IOS_CHECK_XCODE_PACKAGE_AUTHORIZATION_PROVIDER=""

# Xcode gates fail closed when enabled. They use simulator/test builds and pass
# CODE_SIGNING_ALLOWED=NO without changing project signing settings.
IOS_CHECK_ENABLE_XCODE=1
IOS_CHECK_REQUIRE_XCODE=1
IOS_CHECK_ENABLE_TESTS=1
IOS_CHECK_ENABLE_UI_TESTS=0

# Static gates. Keep these enabled unless a project-specific migration task
# explicitly documents a temporary exception.
IOS_CHECK_ENABLE_SWIFT_FORMAT=1
IOS_CHECK_ENABLE_SWIFTFORMAT=0
IOS_CHECK_ENABLE_SWIFTLINT=1
IOS_CHECK_ENABLE_SEMGREP=1
IOS_CHECK_SEMGREP_CONFIG=".semgrep.yml"
IOS_CHECK_ENABLE_GITLEAKS=1
# Set this to a nested package directory when Package.swift is not at repo root.
IOS_CHECK_SPM_PATH="."
IOS_CHECK_ENABLE_SPM=0
IOS_CHECK_ENABLE_SPM_TESTS=0
IOS_CHECK_ENABLE_PERIPHERY=0
IOS_CHECK_ENABLE_SNAPSHOTS=0

# Colon-separated generated-source allowlist roots. Generated roots are skipped
# only by PitchAI pattern rules, not by secrets or compiler gates.
IOS_CHECK_GENERATED_ALLOWLIST=""
