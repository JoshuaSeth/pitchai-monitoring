  "queries": {
    "quota_date_coverage": "WITH RECURSIVE days(day) AS (SELECT '2026-07-27' UNION ALL SELECT date(day,'+1 day') FROM days WHERE day<'2026-08-02') SELECT day,count(observation_key) AS observations,count(DISTINCT account) AS accounts FROM days LEFT JOIN observations ON date(observed,'unixepoch')=day GROUP BY day ORDER BY day",
    "positive_call_deadlines": "SELECT account,weekly_reset AS reset,datetime(weekly_reset,'unixepoch') AS reset_utc,datetime(min(timestamp),'unixepoch') AS first_positive_call_utc,datetime(max(timestamp),'unixepoch') AS last_positive_call_utc,min(weekly_used) AS min_used,max(weekly_used) AS max_used,count(*) AS calls FROM account_calls WHERE strict_eligible=1 AND weekly_used>0 AND day BETWEEN '2026-07-27' AND '2026-08-02' GROUP BY account,weekly_reset ORDER BY account,weekly_reset",
    "manual_epoch_match": "SELECT account,segment,datetime(start_at,'unixepoch') AS start_utc,datetime(end_at,'unixepoch') AS end_utc,datetime(reset,'unixepoch') AS reset_utc,delta_pp,transition_grade FROM epochs WHERE account='A02' AND ABS(reset-1786988233)<=30 AND start_at>=unixepoch('2026-08-10T17:37:12.762Z') AND start_at<unixepoch('2026-08-17T17:37:13Z')",
    "nearby_narrative_samples": "SELECT observation_key,account,observed,duration,reset,used,source_kind,freshness,stale,observed-? AS seconds_after_receipt FROM observations WHERE account=? AND duration=604800 AND observed BETWEEN ? AND ? AND stale=0 ORDER BY ABS(observed-?) LIMIT 5",
    "manual_to_positive_bridge": "WITH ordered AS (\n SELECT *,LAG(reset) OVER (PARTITION BY account ORDER BY observed) AS prior_reset,\n LAG(used>0) OVER (PARTITION BY account ORDER BY observed) AS prior_positive,\n LAG(available_count) OVER (PARTITION BY account ORDER BY observed) AS prior_count,\n LAG(observed) OVER (PARTITION BY account ORDER BY observed) AS prior_at\n FROM guardian_snapshots WHERE account IN ('A02','A07','A08')\n AND observed>=unixepoch('2026-08-10T19:00:00Z') AND observed<unixepoch('2026-08-12T12:00:00Z')\n), grouped AS (\n SELECT *,SUM(CASE WHEN prior_reset IS NULL OR ABS(reset-prior_reset)>30\n OR (used>0)<>prior_positive OR available_count<>prior_count THEN 1 ELSE 0 END)\n OVER (PARTITION BY account ORDER BY observed) AS part FROM ordered\n)\nSELECT account,part,datetime(MIN(observed),'unixepoch') AS first_utc,\n datetime(MAX(observed),'unixepoch') AS last_utc,MIN(used) AS min_used,MAX(used) AS max_used,\n MIN(reset) AS min_reset,MAX(reset) AS max_reset,MIN(available_count) AS min_credits,\n MAX(available_count) AS max_credits,COUNT(*) AS observations,\n MAX(observed-prior_at) AS maximum_gap_seconds FROM grouped GROUP BY account,part ORDER BY account,part"
  },
